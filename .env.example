# CFM Fittings Pro - Environment Configuration
# Copy this file to .env and fill in the values

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=CFM Fittings Pro
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=cfm_postgres
POSTGRES_PORT=5432
POSTGRES_DB=cfm_fittings
POSTGRES_USER=cfm_user
POSTGRES_PASSWORD=cfm_secure_password_change_in_production
DATABASE_URL=postgresql+asyncpg://cfm_user:cfm_secure_password_change_in_production@cfm_postgres:5432/cfm_fittings

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=CFM Fittings Pro
VITE_APP_VERSION=1.0.0

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50

# ─── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://cfm_frontend:5173"]

# ─── First Superadmin (seeded on first run) ──────────────────────────────────
FIRST_SUPERADMIN_EMAIL=admin@cfmfittings.com
FIRST_SUPERADMIN_PASSWORD=Admin@123!ChangeMe
FIRST_TENANT_NAME=CFM Default Tenant
